function doAttack(warriorCount){
setAttackTarget(null);
const target=attackTarget;
const hasFlinta=pTechs.includes(“flintaspets”);
const attackPower=warriorCount*(hasFlinta?5:3);
const defense=defenseScore(target,null);
if(attackPower>defense){
// Win
const newAiV={…aiVillages};
delete newAiV[target.id];
setAiVillages(newAiV);
setAiPts(p=>Math.max(0,p-10));
addLog(`⚔ SEGER! ${target.name} erövrat! Fienden förlorar mark.`);
// Remove warriors used
let toRemove=warriorCount;
const newPV={…pVillages};
Object.keys(newPV).forEach(id=>{
if(toRemove<=0)return;
const v=newPV[id];
const wIdxs=v.buildings.map((b,i)=>b.id===“krigare”?i:-1).filter(i=>i>=0);
while(toRemove>0&&wIdxs.length>0){
const idx=wIdxs.pop();
const nb=[…v.buildings]; nb.splice(idx,1);
newPV[id]={…v,buildings:nb};
toRemove–;
}
});
setPVillages(newPV);
} else {
// Lose – lose warriors + some pop
const diff=defense-attackPower;
addLog(`⚔ FÖRLUST! Anfallet mot ${target.name} slogs tillbaka. Du förlorar ${warriorCount} krigare och ${diff} befolkning.`);
let toRemove=warriorCount;
const newPV={…pVillages};
Object.keys(newPV).forEach(id=>{
const v=newPV[id];
const wIdxs=v.buildings.map((b,i)=>b.id===“krigare”?i:-1).filter(i=>i>=0);
while(toRemove>0&&wIdxs.length>0){
const idx=wIdxs.pop(); const nb=[…v.buildings]; nb.splice(idx,1);
newPV[id]={…v,buildings:nb}; toRemove–;
}
});
// Lose pop from biggest village
const biggest=Object.values(newPV).sort((a,b)=>(b.pop||0)-(a.pop||0))[0];
if(biggest) newPV[biggest.id]={…biggest,pop:Math.max(0,(biggest.pop||0)-diff)};
setPVillages(newPV);
}
}

