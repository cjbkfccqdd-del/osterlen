          <div style={{marginBottom:12,background:"#fff8e8",border:`1px solid ${C.border}`,borderRadius:6,padding:"10px 12px"}}>
            <div style={{display:"flex",justifyContent:"space-between",marginBottom:6}}>
              <span style={{fontSize:11,color:C.ink2}}>👥 Folk: <b>{selV.pop||0}</b></span>
              <span style={{fontSize:10,color:C.ink2}}>🛡 Försvar: <b>{defenseScore(selV,pTechs)}</b></span>
            </div>
            <div style={{height:6,background:"#ddd0a0",borderRadius:3,overflow:"hidden"}}>
              <div style={{height:"100%",width:`${Math.min(100,((selV.pop||0)/30)*100)}%`,background:popColor(selV.pop||0),transition:"width 0.3s"}}/>
            </div>
            {(selV.pop||0)>=20&&<div style={{fontSize:10,color:"#c02020",marginTop:5,fontStyle:"italic"}}>⚠ Risk för svält och konflikter!</div>}
          </div>
          {(selV.buildings||[]).length>0&&(
            <div style={{marginBottom:12,display:"flex",gap:6,flexWrap:"wrap"}}>
              {selV.buildings.map((b,i)=>(<div key={i} style={{background:"#fff8e8",border:`1px solid ${C.border}`,borderRadius:5,padding:"4px 10px",fontSize:12,color:C.ink2}}>{b.icon} {b.label}</div>))}
            </div>
          )}
          <div style={{fontSize:11,color:"#9a7040",fontStyle:"italic",marginBottom:10}}>
            Öppna <b>🌳 Utvecklingsträdet</b> för att välja vad du vill bygga här.
          </div>
          <button onClick={()=>{setShowTechTree(true);}} style={{width:"100%",background:C.gold,border:`1.5px solid ${C.ink}`,color:C.ink,padding:"12px",borderRadius:6,cursor:"pointer",fontFamily:"inherit",fontSize:13,fontWeight:"bold",touchAction:"manipulation"}}>🌳 Öppna Utvecklingsträd</button>
          <div style={{marginTop:14,borderTop:`1px solid ${C.border}`,paddingTop:12}}>
            <div style={{fontSize:9,color:"#9a7040",letterSpacing:2,marginBottom:8}}>ERA-FRAMSTEG</div>
            <div style={{display:"flex",gap:3}}>
              {ERA_NAMES.map((name,i)=>(
                <div key={i} style={{flex:1}}>
                  <div style={{height:4,borderRadius:2,marginBottom:4,background:i<era?C.gold:i===era?`linear-gradient(90deg,${C.gold} ${pct}%,#d8c8a0 ${pct}%)`:"#d8c8a0"}}/>
                  <div style={{fontSize:8,color:i<=era?"#6a5a30":"#c0a880",textAlign:"center"}}>{name}</div>
                </div>
              ))}
            </div>
          </div>
          <div style={{marginTop:12,borderTop:`1px solid ${C.border}`,paddingTop:10}}>
            <div style={{fontSize:9,color:"#9a7040",letterSpacing:2,marginBottom:6}}>LOGG</div>
            {pLog.slice(0,5).map((e,i)=>(<div key={i} style={{fontSize:11,color:i===0?C.ink2:"#a08040",marginBottom:3,lineHeight:1.5,opacity:1-i*0.18,fontStyle:"italic"}}>{e}</div>))}
          </div>
        </>
      ):(
        <button onClick={()=>tapSlot(VILLAGE_SLOTS.find(s=>s.id===selected))} style={{display:"flex",justifyContent:"space-between",alignItems:"center",width:"100%",background:"#fffbee",border:`1.5px solid ${C.border}`,color:C.ink2,padding:"14px",textAlign:"left",cursor:"pointer",fontFamily:"inherit",borderRadius:6,touchAction:"manipulation"}}>
          <div><div style={{fontSize:14}}>🏠 Grunda by här</div><div style={{fontSize:11,color:"#9a7840",marginTop:2,fontStyle:"italic"}}>Kostar 1 sten · 3 folk · +2 poäng</div></div>
          <div style={{textAlign:"right"}}><div style={{fontSize:12}}>⬡ 1</div><div style={{fontSize:10,color:"#9a7840"}}>★ +2</div></div>
        </button>
      )}
    </div>
  </div>

  {/* MODALS */}
  {showTechTree&&<TechTreePanel villages={pVillages} globalTechs={pTechs} stone={pStone} charBuildDiscount={curP?.char?.buildDiscount||[]} onBuild={(id)=>{if(selected&&pVillages[selected])buildInVillage(id); else{const freeV=Object.keys(pVillages)[0]; if(freeV){setSelected(freeV); setTimeout(()=>buildInVillage(id),50);}}}} onClose={()=>setShowTechTree(false)}/>}
  {discoveryQueue.length>0&&<DiscoveryModal site={discoveryQueue[0]} onClose={()=>setDiscoveryQueue(q=>q.slice(1))}/>}
  {pendingEvent&&<EventModal event={pendingEvent} villages={pVillages} globalTechs={pTechs} onResolve={r=>{resolveEvent(r);}}/>}
  {showAiTurn&&<AiTurnModal aiPersonality={aiPersonality} log={showAiTurn.log} onClose={()=>{setShowAiTurn(null); const ev=rollEvent(pTurn); if(ev)setPendingEvent(ev);}}/>}
  {attackTarget&&<AttackModal targetVillage={attackTarget} playerVillages={pVillages} globalTechs={pTechs} onAttack={doAttack} onClose={()=>setAttackTarget(null)}/>}
</div>
