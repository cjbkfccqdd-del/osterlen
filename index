function defenseScore(v, globalTechs){
if(!v) return 0;
const palissads = (v.buildings||[]).filter(b=>b.id===“palissad”).length;
const warriors  = (v.buildings||[]).filter(b=>b.id===“krigare”).length;
const hasFlinta = (globalTechs||[]).includes(“flintaspets”) || (v.buildings||[]).some(b=>b.id===“flintaspets”);
return Math.floor((v.pop||0)/3) + palissads*3 + warriors*(hasFlinta?5:3);
}

function applyEvent(event, villages, globalTechs){
const vList=Object.values(villages);
let stoneDelta=0,ptsDelta=0,villageUpdates={},halfStone=false,msg=””;
if(event.type===“good”){
if(event.effect===“stone+4”)      { stoneDelta=4;  msg=“Havet gav rikligt. +4 sten!”; }
if(event.effect===“stone+5”)      { stoneDelta=5;  msg=“Strandfynd! +5 sten!”; }
if(event.effect===“stone+3pts+5”) { stoneDelta=3; ptsDelta=5; msg=“Handelsmän passerade. +3 sten, +5 poäng!”; }
if(event.effect===“pop+2-all”)    { vList.forEach(v=>{villageUpdates[v.id]={…v,pop:Math.min(30,(v.pop||0)+2)};}); msg=“Fredad säsong. Alla byar växer!”; }
}
if(event.type===“cat”){
if(event.effect===“pop-2-all”)    { vList.forEach(v=>{villageUpdates[v.id]={…v,pop:Math.max(0,(v.pop||0)-2)};}); msg=“Torka härjar. Folk lämnar boplatserna.”; }
if(event.effect===“pop-3-rnd”)    { const v=vList[Math.floor(Math.random()*vList.length)]; if(v){villageUpdates[v.id]={…v,pop:Math.max(0,(v.pop||0)-3)}; msg=`Översvämning vid ${v.name}. –3 befolkning.`;} }
if(event.effect===“pop-4-big”)    { const v=[…vList].sort((a,b)=>(b.pop||0)-(a.pop||0))[0]; if(v){villageUpdates[v.id]={…v,pop:Math.max(0,(v.pop||0)-4)}; msg=`Pestilens slår mot ${v.name}. –4 befolkning.`;} }
if(event.effect===“stone-half”)   { halfStone=true; msg=“Hård vinter. Stenstinsamlingen halveras.”; }
if(event.effect===“destroy-bld”)  { const wB=vList.filter(v=>(v.buildings||[]).length>0); if(wB.length){const v=wB[Math.floor(Math.random()*wB.length)]; const nb=[…v.buildings]; nb.splice(Math.floor(Math.random()*nb.length),1); villageUpdates[v.id]={…v,buildings:nb}; msg=`Brand i ${v.name}! Ett monument förstörs.`;}else{msg=“Skogsbrand – men inga byar drabbades.”;} }
}
if(event.type===“enemy”){
const totalDef=vList.reduce((s,v)=>s+defenseScore(v,globalTechs),0);
if(totalDef>=event.power){ msg=`${event.title} – Du höll stånd! Försvaret räckte till.`; }
else{ const diff=event.power-totalDef; const worst=[…vList].sort((a,b)=>(b.pop||0)-(a.pop||0))[0]; if(worst){villageUpdates[worst.id]={…worst,pop:Math.max(0,(worst.pop||0)-diff)};} msg=`${event.title} – Anfallet slog igenom! ${worst?.name||"En by"} förlorade ${diff} befolkning.`; }
}
return {stoneDelta,ptsDelta,villageUpdates,halfStone,msg};
}

