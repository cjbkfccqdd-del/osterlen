function getTech(id){ return TECH_TREE.find(t=>t.id===id); }

// What has been built/researched across ALL player villages?
function getUnlocked(villages, techs){
const built = new Set(techs||[]);
Object.values(villages).forEach(v=>{
(v.buildings||[]).forEach(b=>built.add(b.id));
});
return built;
}

function isAvailable(techId, villages, techs){
const t = getTech(techId); if(!t) return false;
const built = getUnlocked(villages, techs);
return t.requires.every(r=>built.has(r));
}

